@startuml
!pragma layout smetana
title Arquitetura do Abrigo do Wlad

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontColor #1F2937
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2
skinparam packageBorderColor #CBD5E1
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #94A3B8
skinparam componentBackgroundColor #FFFFFF
skinparam databaseBorderColor #94A3B8
skinparam databaseBackgroundColor #FFFFFF
skinparam noteBorderColor #FDBA74
skinparam noteBackgroundColor #FFF7ED

actor "Pessoa candidata" as candidate
actor "Equipe do abrigo" as staff

package "Cloudflare" as cloudflare {
  package "Worker do app\nabrigo-do-wlad" as app_worker {
    component "SPA React\nStatic Assets" as spa
    component "Roteador /api/*" as router
    component "Candidaturas\nvalidação · sanitização · criptografia" as adoption
    component "Consulta do\ncão em destaque" as hero_api
    component "Catálogo e perfis\npúblicos de cães" as dogs_api
    component "Leituras públicas\nreciclagem · configurações" as public_data
  }

  component "Worker de cron\nabrigo-do-wlad-worker" as cron
  package "Admin protegido" as admin_app {
    component "Cloudflare Access\nJWT + MFA" as access
    component "SPA administrativa" as admin_spa
    component "Worker admin\nRBAC · CRUD · mídia" as admin_worker
  }
  database "Cloudflare KV\nrate limit · destaque · catálogo\nslugs · tombstones" as kv
}

package "Google" as google {
  component "reCAPTCHA v3" as recaptcha
  database "Firestore\ndogs · adoption_application" as firestore
  component "Apps Script\nwebhook de e-mail" as email_webhook
}

package "Cloudinary" as cloudinary {
  component "Imagens dos animais" as images
}

package "Gmail" as gmail {
  component "Notificação\npor e-mail" as email
}

candidate --> spa : navega e preenche o formulário
staff --> access : autentica
access --> admin_spa : identidade autorizada
admin_spa --> admin_worker : /api/session · /api/admin/*
admin_worker --> firestore : REST · conta de serviço\nCRUD · arquivo · retenção
admin_worker --> images : upload assinado · exclusão validada
admin_worker --> kv : atualiza catálogo e tombstones
spa --> router : GET /api/hero-dog
router --> hero_api
hero_api --> kv : lê hero-dog
spa --> router : GET /api/dogs\nGET /api/dogs/by-slug/:slug
router --> dogs_api
dogs_api --> kv : consulta catálogo e perfis
dogs_api --> firestore : REST · reconstrução do catálogo
spa --> router : GET /api/recycle-points\nGET /api/system/settings
router --> public_data
public_data --> firestore : REST · conta de serviço\nsomente campos públicos

spa --> router : POST /api/adoption/create\nIdempotency-Key: UUID v4
router --> adoption
adoption --> kv : rate limit
adoption --> recaptcha : valida reCAPTCHA
adoption --> firestore : CREATE candidatura\nID = Idempotency-Key\nprecondição exists: false
adoption --> email_webhook : POST · secret · conteúdo · debug
email_webhook --> email : envia notificação

cron --> firestore : seleciona destaque · lê cães\nlimpa candidaturas e cães vencidos
cron --> kv : atualiza destaque e catálogo

note right of adoption
  Uma repetição com a mesma chave recebe
  o ID já existente e não cria outro
  documento nem outra notificação.
end note

@enduml
