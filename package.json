{
  "name": "abrigo-do-wlad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:public",
    "dev:public": "npm run dev --workspace @abrigo/public",
    "dev:admin": "npm run dev --workspace @abrigo/admin",
    "dev:admin:mock": "npm run dev:mock --workspace @abrigo/admin",
    "dev:cron": "wrangler dev --config workers/cron/wrangler.jsonc --test-scheduled",
    "build": "npm run build:public && npm run build:admin",
    "build:app": "npm run build:public",
    "build:public": "npm run build --workspace @abrigo/public",
    "build:admin": "npm run build --workspace @abrigo/admin",
    "build:cron": "wrangler deploy --dry-run --config workers/cron/wrangler.jsonc --outdir .wrangler/cron-check",
    "check:admin-worker": "wrangler deploy --dry-run --config apps/admin/wrangler.jsonc --outdir .wrangler/admin-check",
    "check:admin-worker:local": "wrangler deploy --dry-run --env local --config apps/admin/wrangler.jsonc --outdir .wrangler/admin-local-check",
    "check:public-worker": "wrangler deploy --dry-run --outdir .wrangler/public-check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "docs:diagrams": "bash scripts/render-diagrams.sh",
    "check:cron": "npm run build:cron",
    "test": "npm run test:unit && npm run test:frontend && npm run test:worker && npm run test:rules",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:frontend": "vitest run --config vitest.config.ts --project frontend --passWithNoTests",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project abrigo-rules-test \"node --test tests/firestore-rules.test.mjs\"",
    "typecheck:worker": "tsc --noEmit -p tests/worker/tsconfig.json",
    "typecheck:admin-worker": "tsc --noEmit -p apps/admin/worker/tsconfig.json",
    "test:e2e": "playwright test --project=chromium --pass-with-no-tests",
    "test:e2e:all": "playwright test --pass-with-no-tests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint --no-warn-ignored apps packages workers tests *.ts",
    "lint:public": "eslint apps/public/src apps/public/vite.config.ts",
    "lint:admin": "npm run lint --workspace @abrigo/admin",
    "lint:jaci": "eslint packages/ui/src",
    "lint:ui": "npm run lint:jaci",
    "preview": "npm run preview:public",
    "preview:public": "npm run preview --workspace @abrigo/public",
    "preview:admin": "npm run preview --workspace @abrigo/admin",
    "deploy": "npm run build:app && wrangler deploy",
    "deploy:public": "npm run deploy",
    "deploy:admin": "npm run build:admin && wrangler deploy --config apps/admin/wrangler.jsonc",
    "deploy:cron": "wrangler deploy --config workers/cron/wrangler.jsonc"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase": "^12.8.0",
    "firebase-tools": "^15.34.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@cloudflare/vitest-pool-workers": {
      "zod": "$zod"
    },
    "miniflare": {
      "sharp": "^0.35.5",
      "undici": "^7.30.1"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "gaxios@6": {
      "uuid": "^11.1.1"
    }
  }
}
